# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1 localhost

# PostgreSQL.
# A DATABASE_URL is usually set by the host platform (e.g. on Dokku, `postgres:link` sets it).
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/blindtest

# Cache shared by the web process and the bot.
# A REDIS_URL is usually set by the host platform (e.g. on Dokku, `redis:link` sets it).
# Left empty, each process keeps its own in-memory cache.
REDIS_URL=

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Guild ID for instant slash-command syncing in development; space-separated for several guilds.
TEST_GUILD_ID=

# Discord OAuth2 of the same application, used by the web admin login.
# Register <DISCORD_REDIRECT_URI> among the application's OAuth2 redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

